# Prisma SQLite. Relative paths are resolved from the prisma/ directory
# (so file:./dev.db → prisma/dev.db). For production use an absolute path on
# persistent disk the process can write to, e.g. file:/var/lib/krcapp/prod.db
# Ephemeral filesystems lose the DB (and .db-wal / .db-shm) on restart.
DATABASE_URL="file:./dev.db"

# Auth.js session signing secret. REQUIRED.
# Generate: openssl rand -base64 32
# Use a long random value; never commit the real secret. Rotating it signs everyone out.
AUTH_SECRET="replace-with-a-long-random-string"

# Public origin users actually open (scheme + host, plus port if not 80/443). REQUIRED.
# Local only: http://localhost:3000
# Production: https://your.real.domain  — not localhost, not 127.0.0.1, no trailing slash.
# Must match the real HTTPS URL (Auth.js callbacks / cookies).
AUTH_URL="http://localhost:3000"

# Web Push VAPID key pair. Generate: npm run vapid
# (or: npx web-push generate-vapid-keys / node scripts/generate-vapid.mjs)
# NEXT_PUBLIC_VAPID_PUBLIC_KEY is inlined at `npm run build` — set production
# keys before building. Keep the pair together; rotating keys drops existing subscriptions.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""

# VAPID contact URI: mailto: or an https URL. Must not be localhost.
# Production: mailto:ops@your.real.domain  or  https://your.real.domain
VAPID_SUBJECT="mailto:admin@krc.app"
